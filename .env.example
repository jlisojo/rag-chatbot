# Local model config (defaults shown; override as needed)
CHAT_MODEL=llama3.2:3b
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434

# Chunking and retrieval tuning
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_K=4

# Provider switches: "ollama" (default, local) or hosted alternatives used for
# the public demo deployment where Ollama isn't available.
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

# Required only when LLM_PROVIDER=groq. Get a free key at console.groq.com.
# Never commit a real key — this file is a template, .env itself is gitignored.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

# Used only when EMBEDDING_PROVIDER=huggingface. No API key needed.
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
